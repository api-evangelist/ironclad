{
  "item": [
    {
      "id": "eda0c6ad-8ab7-4848-a7a1-149fe4fa12a4",
      "name": "Authorization",
      "description": {
        "content": "OAuth 2.0 authorization endpoints for token management and user authentication.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "9b2a7d37-4933-4546-84a8-92f093e70878",
          "name": "Initiate an Authorization Transaction",
          "request": {
            "name": "Initiate an Authorization Transaction",
            "description": {
              "content": "This endpoint is used to request authorization from a user to access their Ironclad data on their behalf. This is the initial request of an Authorization Code grant flow. The client application generally initiates the authorization flow, where a user will be redirected to Ironclad to log in and grant the requested permissions. The user is then redirected back to the client application redirect URI with an authorization code. See endpoint [specification](https://datatracker.ietf.org/doc/html/rfc6749#section-3.1).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) The expected response type for the request. Must be set to 'code' for the Authorization Code grant."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The client ID of the client application issued at registration."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "(Required) The client applications redirect URI. Must be registered on the client application and consistent throughout the authorization transaction."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Specifies the level of access that your client application is requesting. It should be a space-separated string of Ironclad resource scopes that can be found on the client application registration page. The scopes requested must be equal to or a subset of the client application’s registered scopes."
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "An opaque value used by the client application to maintain state between the request and callback. The authorization server includes this value when redirecting the user back to the client application."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "1ee5e2b6-80d2-4c2b-a004-d2d11143b841",
              "name": "If the request is successful, the user will be directed to Ironclad to log in and grant permissions. Then the user will be redirected back to the client application redirect URI with an authorization code. If the user denies the request, they will be redirected back to the client application redirect URI with an error of 'access_denied'. If the request includes an invalid scope, the user will be redirected back to the client application redirect URI with an error of 'invalid_scope'.",
              "originalRequest": {
                "url": {
                  "path": [
                    "authorize"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "response_type",
                      "value": "code"
                    },
                    {
                      "key": "client_id",
                      "value": "6013609108b8f070cee94fc1"
                    },
                    {
                      "key": "redirect_uri",
                      "value": "https://myapp.com/oauth/callback"
                    },
                    {
                      "key": "scope",
                      "value": "public.records.readRecords public.records.createRecords"
                    },
                    {
                      "key": "state",
                      "value": "1234567890"
                    }
                  ],
                  "variable": []
                },
                "method": "GET",
                "body": {}
              },
              "status": "Found",
              "code": 302,
              "header": [
                {
                  "disabled": false,
                  "key": "Location",
                  "value": "https://myapp.com/oauth/callback?code=63d415e0dd0d828c3a878548&state=1234567890",
                  "description": ""
                },
                {
                  "key": "Content-Type",
                  "value": "text/plain"
                }
              ],
              "body": "",
              "cookie": [],
              "_postman_previewlanguage": "text"
            },
            {
              "id": "adc3c281-b500-4b39-9282-3b3c97423b4f",
              "name": "If the request is missing required parameters or has invalid parameters, the client will receive an 'invalid_request' response.",
              "originalRequest": {
                "url": {
                  "path": [
                    "authorize"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "response_type",
                      "value": "code"
                    },
                    {
                      "key": "client_id",
                      "value": "6013609108b8f070cee94fc1"
                    },
                    {
                      "key": "redirect_uri",
                      "value": "https://myapp.com/oauth/callback"
                    },
                    {
                      "key": "scope",
                      "value": "public.records.readRecords public.records.createRecords"
                    },
                    {
                      "key": "state",
                      "value": "1234567890"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
