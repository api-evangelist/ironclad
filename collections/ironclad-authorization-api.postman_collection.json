            },
            {
              "id": "403dad4c-1555-4e25-b060-7fc33901ba33",
              "name": "If the client associated with the initial authorization request does not match the client requesting the token or if the client associated with a token does not match the client requesting a token refresh, the client will receive an 'invalid_client' response.",
              "originalRequest": {
                "url": {
                  "path": [
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
