              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"invalid_request\",\n  \"error_description\": \"Invalid or missing parameters: Invalid value for client_id, expected type UUID\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
              "id": "1773f6f2-b693-4794-817f-ddc74065b315",
              "name": "If the client application is not authorized to use a specific grant type, the client will receive an 'unauthorized_client' response.",
              "originalRequest": {
                "url": {
                  "path": [
                    "authorize"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "response_type",
                      "value": "code"
                    },
                    {
                      "key": "client_id",
                      "value": "6013609108b8f070cee94fc1"
                    },
                    {
                      "key": "redirect_uri",
                      "value": "https://myapp.com/oauth/callback"
                    },
                    {
                      "key": "scope",
                      "value": "public.records.readRecords public.records.createRecords"
                    },
                    {
                      "key": "state",
                      "value": "1234567890"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "Forbidden",
              "code": 403,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"unauthorized_client\",\n  \"error_description\": \"client not authorized to use this oauth grant type\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
